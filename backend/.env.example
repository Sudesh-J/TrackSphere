PORT=4000
DATABASE_URL=postgresql://tracksphere:tracksphere_dev@localhost:5433/tracksphere
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Public URL of the React app (used inside QR codes)
APP_PUBLIC_URL=http://localhost:5173

# Optional — invoice extraction + Gemini assistant (never commit the real key)
GEMINI_API_KEY=
# Optional model override (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Shared secret for the Windows laptop health agent
AGENT_TOKEN=change_me_agent_token
